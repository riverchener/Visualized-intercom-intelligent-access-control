# Qt 应用（qmake 生成）
rk3506b/build/
rk3506b/app/*.o
rk3506b/app/moc_*.cpp
rk3506b/app/moc_*.h
rk3506b/app/ui_*.h
rk3506b/app/qrc_*.cpp
