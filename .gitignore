rk3506b/app/Makefile

# 内核模块
rk3506b/driver/*.ko
rk3506b/driver/*.o
rk3506b/driver/.*.cmd
rk3506b/driver/Module.symvers
rk3506b/driver/modules.order
rk3506b/driver/*.mod
rk3506b/driver/*.mod.c

# MCU 固件
rk3506b/mcu/*.bin
rk3506b/mcu/*.elf
rk3506b/mcu/*.map

# ---------- Python ----------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
venv/
.venv/

